<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MessageParser.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="550"
        Width="1150" Height="680"
        x:Class="MessageParser.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Live Message Protocol Simulator"
        Background="#121214">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *">
        <!-- Header Section -->
        <Border Grid.Row="0" Background="#1E1E22" Padding="20,15" BorderBrush="#2D2D34" BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock Text="Live Message Protocol Simulator" FontSize="20" FontWeight="Bold" Foreground="#ECECF1" />
                <TextBlock Text="Generate, inspect, and query polymorphic network events in real-time." FontSize="12" Foreground="#8E8E9F" />
            </StackPanel>
        </Border>

        <!-- Main Content Section -->
        <Grid Grid.Row="1" ColumnDefinitions="1.3*, 1*" Margin="20">
            
            <!-- Left Side: Simulator Feed & Search -->
            <Border Grid.Column="0" 
                    Background="#1A1A1E" 
                    BorderBrush="#2D2D34" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="20" 
                    Margin="0,0,10,0">
                <Grid RowDefinitions="Auto, Auto, *">
                    <!-- Heading & Control Button -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                        <TextBlock Grid.Column="0" Text="Simulator Stream" FontSize="15" FontWeight="SemiBold" Foreground="#ECECF1" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" 
                                Content="{Binding SimulationButtonText}" 
                                Command="{Binding ToggleSimulationCommand}" 
                                Classes="accent"
                                Padding="15,8"/>
                    </Grid>

                    <!-- Search Controls -->
                    <Border Grid.Row="1" Background="#26262B" Padding="12" CornerRadius="6" Margin="0,0,0,15">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Query Filter" FontSize="11" Foreground="#8E8E9F" FontWeight="Bold"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0" 
                                         Text="{Binding SearchQuery, Mode=TwoWay}"
                                         PlaceholderText="e.g. Latitude > 34.3 or Callsign contains AF"
                                         Background="#141417"
                                         BorderBrush="#3D3D44"
                                         Height="34"
                                         Padding="8,6"
                                         FontSize="12"/>
                                <Button Grid.Column="1" 
                                        Content="Clear" 
                                        Command="{Binding ClearSearchCommand}"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        Background="#3D2024"
                                        Foreground="#F88F92"/>
                            </Grid>
                            <TextBlock Text="Supports structured format: Property Operator Value (e.g. Speed >= 450, State == RUNNING)" FontSize="10" Foreground="#646470" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ListBox containing simulated messages -->
                    <ListBox Grid.Row="2" 
                             ItemsSource="{Binding SimulatedMessages}" 
                             SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                             Background="#141417" 
                             BorderBrush="#26262B" 
                             BorderThickness="1"
                             CornerRadius="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SimulatedMessageItemViewModel">
                                <Border BorderBrush="#26262B" BorderThickness="0,0,0,1" Padding="10,8">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <!-- Time -->
                                            <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="11" Foreground="#8E8E9F" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                                            <!-- Command Type Badge -->
                                            <Border Grid.Column="1" Background="#2B3D5C" CornerRadius="3" Padding="6,2" Margin="8,0" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Bold" Foreground="#A9C7F2"/>
                                            </Border>
                                            <!-- Route -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Sender}" FontSize="11" Foreground="#ECECF1" FontWeight="Medium"/>
                                                <TextBlock Text="→" FontSize="11" Foreground="#8E8E9F"/>
                                                <TextBlock Text="{Binding Receiver}" FontSize="11" Foreground="#ECECF1" FontWeight="Medium"/>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Details Summary -->
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#86E0A3" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Side: Details Pane / Placeholder -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <!-- Details Inspector -->
                <Border Background="#1A1A1E" 
                        BorderBrush="#2D2D34" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20"
                        IsVisible="{Binding HasSelectedMessage}">
                    <Grid RowDefinitions="Auto, Auto, Auto, *">
                        <!-- Heading -->
                        <TextBlock Grid.Row="0" Text="Message Inspector" FontSize="15" FontWeight="SemiBold" Foreground="#ECECF1" Margin="0,0,0,15"/>
                        
                        <!-- Routing visualization -->
                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, *" Margin="0,0,0,20">
                            <Border Grid.Column="0" Background="#26262B" Padding="12,10" CornerRadius="6" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="SENDER" FontSize="9" FontWeight="Bold" Foreground="#8E8E9F" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Sender}" FontSize="15" FontWeight="SemiBold" Foreground="#ECECF1" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                            <PathIcon Grid.Column="1" 
                                      Data="M1 8h11.5M8.5 4.5 12 8 8.5 11.5" 
                                      Width="24" Height="24" 
                                      Foreground="#646470" 
                                      Margin="15,0" 
                                      VerticalAlignment="Center"/>
                            
                            <Border Grid.Column="2" Background="#26262B" Padding="12,10" CornerRadius="6" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="RECEIVER" FontSize="9" FontWeight="Bold" Foreground="#8E8E9F" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Receiver}" FontSize="15" FontWeight="SemiBold" Foreground="#ECECF1" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Command Type -->
                        <Grid Grid.Row="2" ColumnDefinitions="Auto, *" Margin="0,0,0,20">
                            <TextBlock Grid.Column="0" Text="Command:" FontSize="13" Foreground="#8E8E9F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Grid.Column="1" Background="#3E2B5C" Padding="10,5" CornerRadius="4" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding CommandName}" FontSize="13" FontWeight="Bold" Foreground="#D5C7F2"/>
                            </Border>
                        </Grid>

                        <!-- Key-Value Payload Details -->
                        <Grid Grid.Row="3" RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="Payload Properties" FontSize="13" FontWeight="SemiBold" Foreground="#ECECF1" Margin="0,0,0,8"/>
                            
                            <ScrollViewer Grid.Row="1" Background="#141417" CornerRadius="6">
                                <ItemsControl ItemsSource="{Binding PayloadItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#26262B" BorderThickness="0,0,0,1" Padding="12,10">
                                                <Grid ColumnDefinitions="*, 1.5*">
                                                    <TextBlock Grid.Column="0" Text="{Binding Key}" FontFamily="Consolas, monospace" Foreground="#86E0A3" FontWeight="Medium"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas, monospace" Foreground="#ECECF1" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- No Selection Placeholder -->
                <Border Background="#1A1A1E" 
                        BorderBrush="#2D2D34" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20"
                        IsVisible="{Binding !HasSelectedMessage}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                        <TextBlock Text="No Message Selected" FontSize="16" FontWeight="SemiBold" Foreground="#ECECF1" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a message from the live stream to inspect its full properties." FontSize="13" Foreground="#646470" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
